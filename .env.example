# Cloud AI API Keys
TYPHOON_API_KEY=your_typhoon_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Configuration (Server-Side)
# Set the host IP where Ollama is running. Default is local machine.
OLLAMA_HOST=http://127.0.0.1:11434

# Default model used for chat if not explicitly overridden by the widget
OLLAMA_MODEL=llama3.1:latest

# Model used strictly for the Evaluation Engine
OLLAMA_EVAL_MODEL=llama3.1
